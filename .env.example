# Скопируйте в .env.local для локальной разработки; на Vercel — Settings → Environment Variables.
# Сайт работает и без них: заявки тогда пишутся только в логи Vercel.

NEXT_PUBLIC_SITE_URL=https://forma-buro.com

# Заявки в Telegram: бот от @BotFather → токен; chat id — свой (написать боту, затем
# https://api.telegram.org/bot<TOKEN>/getUpdates) или группы (добавить бота в группу, id начинается с -100…).
# Несколько получателей — через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Письма о заявках (resend.com). Домен forma-buro.com верифицировать в Resend (SPF/DKIM).
RESEND_API_KEY=
LEADS_EMAIL_TO=hello@forma-buro.com          # можно несколько через запятую
LEADS_EMAIL_FROM=FORMA BURO <noreply@forma-buro.com>

# Загрузка файлов в форме: Vercel → Storage → Blob → Create (public). Токен подставится сам.
BLOB_READ_WRITE_TOKEN=

# Google Tag Manager (GA4 / Ads / Meta настраиваются внутри GTM). Грузится только после согласия на cookie.
NEXT_PUBLIC_GTM_ID=

# Необязательно: копия каждой заявки JSON-ом в CRM / Make / Zapier / Google Sheets
CRM_WEBHOOK_URL=
